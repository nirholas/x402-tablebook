{
  "x402Version": 1,
  "name": "x402-tablebook",
  "description": "Open-source Resy: a self-hosted restaurant reservation server that AI agents can book via x402 refundable holds",
  "resources": [
    {
      "resource": "GET /availability",
      "description": "Open reservation slots for the booking window: date, time, seatable party sizes, table types, open table count. Filter with ?date=YYYY-MM-DD&party=N&days=N.",
      "price": "$0.001",
      "network": "base-sepolia",
      "asset": "USDC",
      "outputSchema": {
        "type": "object",
        "properties": {
          "restaurant": { "type": "object" },
          "slotMinutes": { "type": "number" },
          "seatingMinutes": { "type": "number" },
          "refundPolicy": { "type": "object" },
          "generatedAt": { "type": "string" },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": { "type": "string" },
                "time": { "type": "string" },
                "partySizes": { "type": "array", "items": { "type": "number" } },
                "tableTypes": { "type": "array", "items": { "type": "string" } },
                "openTables": { "type": "number" }
              }
            }
          }
        }
      }
    },
    {
      "resource": "POST /book",
      "description": "Book a table with a $0.01 refundable hold. Body: {date, time, party, name, notes?}. Returns the confirmed reservation, table assignment, refund terms, cancelToken, ledger entry, HMAC signature, and a base64 ICS calendar invite — all in the 200 response.",
      "price": "$0.01",
      "network": "base-sepolia",
      "asset": "USDC",
      "outputSchema": {
        "type": "object",
        "properties": {
          "reservationId": { "type": "string" },
          "status": { "type": "string", "enum": ["confirmed"] },
          "restaurant": { "type": "string" },
          "confirmedTime": { "type": "string" },
          "party": { "type": "number" },
          "name": { "type": "string" },
          "table": { "type": "object" },
          "refundTerms": { "type": "object" },
          "cancelToken": { "type": "string" },
          "cancelEndpoint": { "type": "string" },
          "ledgerEntry": { "type": "object" },
          "ics": { "type": "string", "description": "base64-encoded RFC 5545 calendar invite" },
          "signature": { "type": "string", "description": "HMAC-SHA256 over canonical JSON" }
        }
      }
    }
  ],
  "freeResources": [
    { "resource": "GET /info", "description": "Restaurant profile, hours, refund policy, prices" },
    { "resource": "POST /cancel/:id", "description": "Cancel a reservation (auth: cancelToken from /book). Returns cancellation record + refund ledger entry." },
    { "resource": "GET /reservations/:id", "description": "Look up a reservation (auth: cancelToken)" },
    { "resource": "GET /health", "description": "Liveness check" }
  ]
}
