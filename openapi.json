                    },
                    "party": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "notes": {
                      "type": "string"
                    },
                    "tableId": {
                      "type": "string"
                    },
                    "tableName": {
                      "type": "string"
                    },
                    "tableType": {
                      "type": "string"
                    },
                    "payerWallet": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "cancelledAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "ledger": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "entryId": {
                            "type": "string"
                          },
                          "reservationId": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "hold",
                              "refund",
                              "forfeit"
                            ]
                          },
                          "amount": {
                            "type": "string"
                          },
                          "wallet": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          },
                          "at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "entryId",
                          "reservationId",
                          "kind",
                          "amount",
                          "reason",
                          "at"
                        ]
                      }
                    }
                  },
                  "required": [
                    "reservationId",
                    "status",
                    "date",
                    "time",
                    "party",
                    "name",
                    "createdAt",
                    "ledger"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Bad cancelToken",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Machine-readable error code"
                    },
