# ── Payment recipients ──────────────────────────────────────────────────────
# Set at least one. Every network configured here becomes an entry in the 402
# challenge, so an agent can pay with whichever wallet it happens to hold.

# EVM. Defaults to USDC on Base mainnet. Use base-sepolia for testing.
EVM_PAY_TO=0xYourMerchantAddress
X402_EVM_NETWORK=base

# Solana. Defaults to USDC on Solana mainnet.
SOLANA_PAY_TO=YourSolanaAddress
X402_SOLANA_NETWORK=solana

# ── Facilitators — verify and settle payments ───────────────────────────────
# EVM facilitator. Sperax by default; https://x402.org/facilitator for testnets.
X402_FACILITATOR_EVM=https://x402.sperax.io

# Solana settles through Coinbase CDP, which requires credentials.
# Without these (or an open X402_FACILITATOR_SOLANA), Solana is NOT advertised —
# the server will not offer a network it cannot settle.
# Create a key at https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Point at a self-hosted Solana facilitator to skip CDP entirely.
# X402_FACILITATOR_SOLANA=https://your-facilitator.example

# ── Signing ─────────────────────────────────────────────────────────────────
# Secret for HMAC-SHA256 signatures on confirmations and cancellations.
# A development default is baked in — ALWAYS set your own in production.
SIGNING_SECRET=change-me-to-a-long-random-string

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4021

# Public origin of this deployment. Only needed when a proxy rewrites the Host
# header. Sets the OpenAPI `servers` entry and the 402 `resource` field.
# PUBLIC_URL=https://your-deployment.example

# Where reservations + ledger JSON live (created automatically).
DATA_DIR=data

# Restaurant floor plan / hours / refund policy.
TABLES_CONFIG=config/tables.json

# ── Client examples only ────────────────────────────────────────────────────
# Private key of the PAYING wallet for examples/agent-client.ts.
# Fund with base-sepolia USDC: https://faucet.circle.com
# PRIVATE_KEY=0x...
# BASE_URL=http://localhost:4021

# ── Renamed in 0.2.0 ────────────────────────────────────────────────────────
# PAY_TO_ADDRESS  → EVM_PAY_TO          (old name still read as a fallback)
# NETWORK         → X402_EVM_NETWORK
# FACILITATOR_URL → X402_FACILITATOR_EVM
